# Website F&B Rancan — contoh environment (nilai asli di .env host, jangan commit)
NODE_ENV=production
PORT=3100

# AI Gateway (Hermes CS, model "cs")
CS_API_URL=http://172.20.0.1:8902/v1/chat/completions
AI_GATEWAY_KEY=ganti-dengan-key-gateway

# Chatwoot (self-host)
CHATWOOT_INTERNAL_URL=http://chatwoot-rails-1:3000
CHATWOOT_ACCOUNT_ID=2
CHATWOOT_INBOX_ID=2
CHATWOOT_WEBSITE_TOKEN=website-token-inbox-webwidget
CW_ADMIN_TOKEN=api-access-token-admin-chatwoot

# Takeover guard
TAKEOVER_CACHE_TTL_MS=8000
